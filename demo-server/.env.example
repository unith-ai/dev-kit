# Copy to .env and fill in. Never commit .env.

# --- UNITH platform credentials (interFace → Manage Account) ---
UNITH_EMAIL=you@yourcompany.com
UNITH_SECRET_KEY=your-secret-key

# Required for multi-org accounts (omit otherwise)
UNITH_ORG_ID=

# Org PUBLIC id for the data API and embeds (GET /user/me → organisation.publicId, e.g. MyOrg-1234)
UNITH_PUBLIC_ORG_ID=

# --- Demo defaults ---
UNITH_HEAD_VISUAL_ID=
UNITH_TTS_PROVIDER=elevenlabs
UNITH_TTS_VOICE=Xb7hH8MSUJpSbSDYk0k2_eleven_turbo_v2_5

# --- Local server ---
PORT=3000
# Public URL of the tunnel in front of this server (ngrok / cloudflared)
TUNNEL_URL=https://your-tunnel.example.com
# Shared secret returned when registering the webhook (HMAC verification)
UNITH_WEBHOOK_SECRET=

# --- Local LLM (Chapter 4, optional) — Qwen3.5-4B via mlx_lm.server (Apple Silicon) ---
# Start it:  uvx --from 'mlx-lm>=0.30' --python 3.12 mlx_lm.server --model mlx-community/Qwen3.5-4B-MLX-4bit --port 1234 --chat-template-args '{"enable_thinking": false}'
LOCAL_LLM=off
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit
